rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function hasRoleDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function roleDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Tài khoản bị Admin "Vô hiệu hóa" trong app (users/{uid}.disabled ==
    // true) vẫn còn document users/{uid} (giữ lại lịch sử email/vai trò
    // cũ), nhưng mọi rule bên dưới phải coi như KHÔNG có vai trò gì —
    // tự động mất hết quyền đọc/ghi ngay từ lần request tiếp theo.
    function isActiveRole(r) {
      return signedIn() && hasRoleDoc() && roleDoc().role == r && roleDoc().get('disabled', false) != true;
    }
    function isAdmin() {
      return isActiveRole('admin');
    }
    function isCollector() {
      return isActiveRole('collector');
    }
    // Vai trò thứ 3: xem toàn bộ dữ liệu (dùng cho Ban giám đốc) nhưng
    // KHÔNG được tạo/sửa/xóa bất kỳ tài sản/ticket nào.
    function isViewer() {
      return isActiveRole('viewer');
    }
    // Vai trò thứ 4: "reportonly" — tài khoản chỉ dùng cho trang "Đề nghị
    // thanh toán" trên app (đọc PDF hóa đơn -> tạo Excel), vốn chạy 100% trên
    // thiết bị (không gọi Firestore). Vai trò này CỐ Ý không được thêm vào bất
    // kỳ rule "allow read/write" nào bên dưới -> mặc định không đọc/ghi
    // được assets/tickets/employees/users(người khác)/... gì cả, chỉ
    // đăng nhập + tự đọc đúng document users/{uid} của chính mình (đã cho
    // phép ở rule "users" bên dưới) để app xác định vai trò.
    function isReportOnly() {
      return isActiveRole('reportonly');
    }
    // Bất kỳ tài khoản nào đã được gán 1 trong 3 vai trò trên (dùng để
    // gọn các rule chỉ cần "đã đăng nhập hợp lệ, đọc được mọi thứ").
    function isKnownRole() {
      return isAdmin() || isCollector() || isViewer();
    }

    // ---------- Validate dữ liệu (trước đây Rules chỉ kiểm tra "ai được ghi",
    // không kiểm tra "ghi cái gì" — 1 request hợp lệ về quyền vẫn có thể nhét
    // số âm/chuỗi khổng lồ vào field. Các hàm dưới đây thêm 1 lớp kiểm tra tối
    // thiểu về kiểu dữ liệu cho các field tài chính/định danh quan trọng, áp
    // dụng cho request.resource.data (dữ liệu SẮP được ghi). Không kiểm tra
    // toàn bộ field (một số field tự do như "note" cố tình để lỏng) — mục tiêu
    // là chặn các giá trị rõ ràng sai (âm, sai kiểu), không phải validate đầy
    // đủ schema. ----------
    function isNonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }
    function isNonNegNumber(v) {
      return v is number && v >= 0;
    }
    // Với field optional: hoặc không có trong request, hoặc có và hợp lệ.
    function optionalNonNegNumber(d, key) {
      return !(key in d) || isNonNegNumber(d[key]);
    }

    // Roles collection: users/{uid} -> { role: "admin" | "collector" | "viewer" }
    // Create one doc per account manually in Firebase Console > Firestore.
    // An account with no doc here has no access to anything below.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /assets/{assetId} {
      // Admin, Collector và Viewer đều browse/search được toàn bộ.
      allow read: if isAdmin() || isCollector() || isViewer();
      // Chỉ Collector (và Admin) được TẠO tài sản mới — Viewer không được
      // tạo bất kỳ tài sản nào, kể cả nháp. Bắt buộc "code" là chuỗi không
      // rỗng ngay từ lúc tạo (trước đây Rules chỉ kiểm tra vai trò, không
      // kiểm tra dữ liệu — 1 request hợp lệ quyền vẫn tạo được tài sản
      // không mã, rất khó dọn dẹp sau này).
      allow create: if (isAdmin() || isCollector()) && isNonEmptyString(request.resource.data.code, 100);
      // Chỉ Admin được sửa/xóa tài sản đã có — kể cả tài sản Collector vừa
      // tạo. Đây là cơ chế "ghi 1 lần" cho Collector; Viewer không nằm
      // trong danh sách này nên tất nhiên cũng không sửa/xóa được.
      allow update: if isAdmin() && isNonEmptyString(request.resource.data.code, 100);
      allow delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      // Cùng mô hình đọc/ghi như assets: Admin/Collector/Viewer đều đọc
      // được toàn bộ; chỉ Collector (và Admin) tạo được ticket mới; chỉ
      // Admin sửa/xóa được ticket đã có (kể cả ticket của chính mình).
      allow read: if isAdmin() || isCollector() || isViewer();
      // Bắt buộc "ticketId" là chuỗi không rỗng ngay từ lúc tạo — cùng lý do
      // với "code" của assets (tránh ticket rỗng/không định danh được).
      allow create: if (isAdmin() || isCollector()) && isNonEmptyString(request.resource.data.ticketId, 100);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /projects/{projectId} {
      // Dự án CNTT — cùng mô hình quyền như tickets: Admin/Collector/Viewer
      // đều đọc được toàn bộ; chỉ Collector (và Admin) tạo được dự án mới;
      // chỉ Admin sửa/xóa được dự án đã có. "File đính kèm" thực chất chỉ
      // là link (Google Drive/OneDrive/Zalo...) do người dùng tự dán, lưu
      // trong field `attachments` của chính document này — KHÔNG dùng
      // Firebase Storage (tránh phải nâng gói Blaze trả phí).
      allow read: if isAdmin() || isCollector() || isViewer();
      allow create: if isAdmin() || isCollector();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /employees/{employeeId} {
      // Danh sách nhân viên đồng bộ từ file HR (Dữ liệu → "Nhân viên (HR)").
      // Admin/Collector/Viewer đều cần ĐỌC để dùng autocomplete "Người sử
      // dụng" trên form tài sản/ticket (Viewer chỉ xem chi tiết, không cần
      // autocomplete nhưng đọc không hại gì). Chỉ Admin được GHI — import
      // Excel HR là thao tác quản trị.
      allow read: if isAdmin() || isCollector() || isViewer();
      allow write: if isAdmin();
    }

    // ---------- Bình luận / chỉ đạo (nền tảng cho tính năng "tick, comment"
    // của Ban giám đốc — CHƯA có UI, chỉ mở sẵn Rules để làm trước không
    // phải sửa lại schema sau này) ----------
    // comments/{commentId} -> {
    //   targetType: "ticket" | "asset" | "po",  targetId: string,
    //   authorUid: string, authorEmail: string, authorRole: string,
    //   text: string, createdAt: timestamp
    // }
    match /comments/{commentId} {
      allow read: if isKnownRole();
      // Ai cũng tạo được bình luận của CHÍNH MÌNH (kể cả Viewer) — nhưng
      // bắt buộc authorUid phải đúng UID đang đăng nhập, không giả mạo
      // được là người khác.
      allow create: if isKnownRole() && request.resource.data.authorUid == request.auth.uid;
      // Chỉ tác giả hoặc Admin mới sửa/xóa được 1 bình luận.
      allow update, delete: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);
    }

    // ---------- Các module tương lai (Hướng dẫn kỹ thuật / Network /
    // Camera / Đơn hàng PO / Quy trình SOP) — hiện UI mới là "Sắp có",
    // nhưng mở sẵn Rules theo đúng mô hình read=3 role / write=Admin để
    // khi build UI thật không cần quay lại sửa Rules. ----------
    match /guides/{guideId} {
      allow read: if isKnownRole();
      allow write: if isAdmin();
    }
    match /network/{docId} {
      allow read: if isKnownRole();
      allow write: if isAdmin();
    }
    match /camera/{docId} {
      allow read: if isKnownRole();
      allow write: if isAdmin();
    }
    match /po/{poId} {
      allow read: if isKnownRole();
      allow write: if isAdmin();
    }
    match /sop/{sopId} {
      allow read: if isKnownRole();
      allow write: if isAdmin();
    }

    // ---------- Module Máy in (printers.js) ----------
    // Chỉ Admin GHI. ĐỌC: Admin + Viewer (Ban giám đốc). Collector CỐ Ý không
    // được đọc vì các collection này chứa giá thuê/giá mua/công nợ với NCC.
    // - printers/{mã máy in}       : máy thuê & tự mua (+ mảng repairs, history)
    // - printer_vendors/{autoId}   : nhà cung cấp
    // - printer_invoices/{autoId}  : hóa đơn phải trả NCC (+ mảng payments)
    match /printers/{printerId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }
    match /printer_vendors/{vendorId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }
    match /printer_invoices/{invoiceId} {
      allow read: if isAdmin() || isViewer();
      // "amount" (số tiền hóa đơn) không được âm, "vendorId" bắt buộc có —
      // trước đây chỉ kiểm tra vai trò Admin, không kiểm tra giá trị.
      // LƯU Ý: create/update tách riêng khỏi delete — lúc delete không có
      // request.resource (không có dữ liệu mới), nếu gộp chung "allow write"
      // với điều kiện đọc request.resource.data thì thao tác xóa sẽ luôn bị
      // từ chối (lỗi, không phải chỉ mất tính năng xóa mà còn khó nhận ra).
      allow create, update: if isAdmin()
        && isNonNegNumber(request.resource.data.amount)
        && isNonEmptyString(request.resource.data.vendorId, 200);
      allow delete: if isAdmin();
    }

    // ---------- Network › cước Internet (network-isp.js) ----------
    // Cùng quy tắc với Máy in: Admin ghi; Admin + Viewer đọc; Collector không thấy.
    // - net_providers/{autoId} : NCC dịch vụ mạng (VNPT, Viettel...) + tài khoản nhận tiền
    // - net_lines/{autoId}     : từng đường truyền / dịch vụ
    // - net_invoices/{autoId}  : hóa đơn / thông báo cước hằng tháng (+ mảng payments)
    match /net_providers/{id} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }
    match /net_lines/{id} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }
    match /net_invoices/{id} {
      allow read: if isAdmin() || isViewer();
      // Cùng lý do với printer_invoices: "amount" không âm, "providerId" bắt
      // buộc có; create/update tách riêng khỏi delete (xem giải thích ở
      // printer_invoices phía trên).
      allow create, update: if isAdmin()
        && isNonNegNumber(request.resource.data.amount)
        && isNonEmptyString(request.resource.data.providerId, 200);
      allow delete: if isAdmin();
    }

    // ---------- Đề nghị thanh toán (payreq.js) ----------
    // pay_requests/{autoId} : lịch sử các "Giấy đề nghị thanh toán" đã lập (NCC, chứng từ,
    // số tiền, tài khoản nhận...) — dùng để cảnh báo trùng hóa đơn và tạo lại file Excel.
    // Cùng quy tắc với Máy in/Network: Admin ghi; Admin + Viewer đọc; Collector không thấy.
    match /pay_requests/{id} {
      allow read: if isAdmin() || isViewer();
      // "total" (tổng tiền giấy đề nghị) không được âm, "code" (mã đề nghị,
      // dùng để cảnh báo trùng) bắt buộc có; create/update tách riêng khỏi
      // delete (xem giải thích ở printer_invoices phía trên).
      allow create, update: if isAdmin()
        && isNonNegNumber(request.resource.data.total)
        && isNonEmptyString(request.resource.data.code, 100);
      allow delete: if isAdmin();
    }

    // ---------- guides/{id} — Hướng dẫn kỹ thuật (tài liệu PDF/Excel/Word...
    // lưu file thật ở Firebase Storage, xem storage.rules match /guides/).
    // Admin/Collector/Viewer đều đọc được (nav không ẩn với Collector); chỉ
    // Admin thêm/sửa/xóa. "title" và "storagePath" (đường dẫn file thật ở
    // Storage) bắt buộc có khác rỗng — tránh bản ghi "mồ côi" không trỏ tới
    // file nào. ----------
    match /guides/{id} {
      allow read: if isAdmin() || isCollector() || isViewer();
      allow create, update: if isAdmin()
        && isNonEmptyString(request.resource.data.title, 200)
        && isNonEmptyString(request.resource.data.storagePath, 300);
      allow delete: if isAdmin();
    }

    // ---------- meta/{docId} — các "cờ trạng thái" nhỏ dùng nội bộ app,
    // hiện chỉ có `homeLaptopExport` (chữ ký danh sách mang laptop về nhà
    // ở lần xuất báo cáo gần nhất, để phát hiện thay đổi và cảnh báo cần
    // xuất lại — xem exportHomeLaptopReport trong app.js). Đọc cho cả 3
    // role để ai cũng thấy cảnh báo nếu cần, chỉ Admin ghi vì chỉ Admin
    // thao tác xuất/gửi báo cáo này. ----------
    match /meta/{docId} {
      allow read: if isKnownRole();
      allow write: if isAdmin();
    }
  }
}
